# General
LEDGER_ENV=development
LEDGER_DATA_DIR=./data
LEDGER_HTTP_TIMEOUT_SECONDS=30

# Alpaca — Phase 2 market data + US security master
# Create a free Alpaca account/API key and put the paper API credentials here.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_HISTORICAL_FEED=sip
ALPACA_LIVE_FEED=iex
# split keeps technical price history continuous through stock splits without folding dividends into price
ALPACA_ADJUSTMENT=split
# Basic plan: full SIP historical data is unavailable for the latest 15 minutes. Set 0 if a future paid plan removes the restriction.
ALPACA_HISTORICAL_DELAY_MINUTES=15


# Futures / metals market data (Phase 6.2 active integration)
# Massive provides CME/CBOT/NYMEX/COMEX futures bars. Ledger Phase 6.2 uses it for
# dated contracts and synthesizes NQ1! with the explicit calendar-front v1 roll policy.
# Account: https://massive.com/
# Futures docs: https://massive.com/docs/rest/futures/overview
# NOTE: *_BASE_URL values below are API roots for Ledger, not normal webpages to open in a browser.
FUTURES_DATA_PROVIDER=massive
MASSIVE_API_KEY=
MASSIVE_FUTURES_BASE_URL=https://api.massive.com
# Continuous futures should remain unadjusted by default to mirror TradingView's default B-ADJ=off.
FUTURES_BACK_ADJUST=false

# Spot-gold/FX source. Phase 6.2 routes Ledger XAUUSD to OANDA XAU_USD.
# A practice account/token is sufficient for development; OANDA_ACCOUNT_ID may remain blank for candles.
# Journal Sync requires BOTH token and account ID. It uses GET-only closed-trade history,
# runs only on explicit Sync broker trades, and never places or changes orders.
# History uses official practice/live roots; candle routing/configuration is unchanged.
# Developer portal/docs: https://developer.oanda.com/rest-live-v20/introduction/
# NOTE: the api-fxpractice/api-fxtrade values below are API roots, not normal webpages.
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_PRACTICE_BASE_URL=https://api-fxpractice.oanda.com
OANDA_LIVE_BASE_URL=https://api-fxtrade.oanda.com

# Read-only Trading 212 Portfolio sync (Invest / Stocks ISA). No execution.
TRADING212_ENABLED=false
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENVIRONMENT=demo

# Tradovate readiness only: no remote API implementation or calls.
TRADOVATE_ENABLED=false
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ENVIRONMENT=demo

# Optional additional backend-only profiles; never commit populated credentials.
# JSON array: id, provider, environment, enabled, credentials. See docs/BROKER_CONNECTIONS.md.
BROKER_PROFILES_JSON=[]

# SEC — no API key required, but SEC requests a declared User-Agent with contact info.
# Replace the example with something like: Ledger/2.0 your-real-email@example.com
SEC_USER_AGENT=Ledger/2.0 your-email@example.com

# Cache periods
FUNDAMENTALS_CACHE_HOURS=12
MACRO_CACHE_MINUTES=15

# FRED macro context
FRED_API_KEY=

# Optional AI journal review (later phase)
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Autochartist research integration scaffold (disabled by default)
# IMPORTANT: access through OANDA's Research Portal/MT4/MT5 plugin does not by
# itself prove that you have reusable developer API credentials. Do not paste
# short-lived portal URLs/tokens here and do not scrape the portal.
AUTOCHARTIST_ENABLED=false
AUTOCHARTIST_BROKER_ID=
AUTOCHARTIST_USER=
AUTOCHARTIST_ACCOUNT_TYPE=LIVE
AUTOCHARTIST_SECRET_KEY=
