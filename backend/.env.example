# General
LEDGER_ENV=development
LEDGER_DATA_DIR=./data
LEDGER_HTTP_TIMEOUT_SECONDS=30

# Alpaca — Phase 2 market data + US security master
# Create a free Alpaca account/API key and put the paper API credentials here.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_HISTORICAL_FEED=sip
ALPACA_LIVE_FEED=iex
# split keeps technical price history continuous through stock splits without folding dividends into price
ALPACA_ADJUSTMENT=split
# Basic plan: full SIP historical data is unavailable for the latest 15 minutes. Set 0 if a future paid plan removes the restriction.
ALPACA_HISTORICAL_DELAY_MINUTES=15

# SEC — no API key required, but SEC requests a declared User-Agent with contact info.
# Replace the example with something like: Ledger/2.0 your-real-email@example.com
SEC_USER_AGENT=Ledger/2.0 your-email@example.com

# Cache periods
FUNDAMENTALS_CACHE_HOURS=12
MACRO_CACHE_MINUTES=15

# FRED macro context
FRED_API_KEY=

# Optional AI journal review (later phase)
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
