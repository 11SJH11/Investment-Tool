# General
LEDGER_ENV=development
LEDGER_DATA_DIR=./data
LEDGER_HTTP_TIMEOUT_SECONDS=30

# Alpaca — Phase 2 market data + US security master
# Create a free Alpaca account/API key and put the paper API credentials here.

ALPACA_API_KEY=PKNMYHBBFQD44VCWVA63JCTCU6
ALPACA_API_SECRET=B71BRBJE3VyvG2eFwAtYyCFfrswNddWs7nDnbZvCiZEL

ALPACA_HISTORICAL_FEED=sip
ALPACA_LIVE_FEED=iex
# split keeps technical price history continuous through stock splits without folding dividends into price
ALPACA_ADJUSTMENT=split
# Basic plan: full SIP historical data is unavailable for the latest 15 minutes. Set 0 if a future paid plan removes the restriction.
ALPACA_HISTORICAL_DELAY_MINUTES=15


# Futures / metals market data (planned provider integration)
# Massive provides CME/CBOT/NYMEX/COMEX futures bars. Ledger will use this for
# contract-level futures such as NQU6/GCZ6 and later synthesize NQ1!/GC1! continuous series.
FUTURES_DATA_PROVIDER=massive
MASSIVE_API_KEY=iihaA8aRNV6puaqtyoy9JtyfSDP1zLAI
MASSIVE_FUTURES_BASE_URL=https://api.massive.com
# Continuous futures should remain unadjusted by default to mirror TradingView's default B-ADJ=off.
FUTURES_BACK_ADJUST=false

# Optional spot-gold/FX source. Use this only if you specifically want an OANDA-style
# XAU_USD chart rather than COMEX gold futures (GC). A practice account/token is sufficient for development.
OANDA_ACCESS_TOKEN=aefaf01b2924a2d50daf77aa2a14dc8f-0f2c88734639b235e743f46d854dffad
OANDA_ACCOUNT_ID=101-004-40333897-001
OANDA_ENVIRONMENT=practice
OANDA_PRACTICE_BASE_URL=https://api-fxpractice.oanda.com
OANDA_LIVE_BASE_URL=https://api-fxtrade.oanda.com



# Read-only Trading 212 Portfolio sync (Invest / Stocks ISA). No execution.
TRADING212_ENABLED=true
TRADING212_API_KEY=50176462ZQBcYVHaowoamhjzVnZZhvWgkxFPi
TRADING212_API_SECRET=hll5K2GrAlVSXnCvIXbtSmlVTgaAERLREwSKXhowndY
TRADING212_ENVIRONMENT=live

# Tradovate readiness only: no remote API implementation or calls.
TRADOVATE_ENABLED=false
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ENVIRONMENT=demo

# Optional additional backend-only profiles; never commit populated credentials.
# JSON array: id, provider, environment, enabled, credentials. See docs/BROKER_CONNECTIONS.md.
BROKER_PROFILES_JSON=[]

# SEC — no API key required, but SEC requests a declared User-Agent with contact info.
# Replace the example with something like: Ledger/2.0 your-real-email@example.com
SEC_USER_AGENT=Ledger/2.0 jamieholt009@gmail.com

