# Ledger safe configuration template: placeholders/public defaults only.
# Copy backend settings into backend/.env locally. Never commit filled-in credentials.
# Existing .env files are not read or modified by this template.
# Settings UI can persist enable/environment preferences, but never passwords/tokens.

MAX_CONCURRENT_BACKTESTS=2

# Application (optional defaults). Backend reads backend/.env when started there.
LEDGER_ENV=development
LEDGER_API_PREFIX=/api
LEDGER_DATA_DIR=./data
LEDGER_HTTP_TIMEOUT_SECONDS=30.0

# Alpaca market data. Key/secret required only for Alpaca, from your Alpaca dashboard.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_HISTORICAL_FEED=sip
ALPACA_LIVE_FEED=iex
ALPACA_ADJUSTMENT=split
ALPACA_HISTORICAL_DELAY_MINUTES=15
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Futures data. Massive key required only for Massive; subscription controls entitlement.
FUTURES_DATA_PROVIDER=massive
MASSIVE_API_KEY=
MASSIVE_CALLS_PER_MINUTE=5
MASSIVE_FUTURES_BASE_URL=https://api.massive.com
FUTURES_BACK_ADJUST=false

# OANDA. Token from OANDA API access; account ID also required for Journal. practice/live.
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_PRACTICE_BASE_URL=https://api-fxpractice.oanda.com
OANDA_LIVE_BASE_URL=https://api-fxtrade.oanda.com

# Trading 212. Enable only for Invest/ISA read-only import; key/secret from Trading 212 API settings. demo/live.
TRADING212_ENABLED=false
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENVIRONMENT=demo

# Optional additional broker profiles. JSON credentials remain backend-only; never commit populated values.
BROKER_PROFILES_JSON=[]

# TradeLocker. email/password/server required when enabled, from broker login. demo/live. Account ID optional: select account in Settings. Developer API key optional if issued by TradeLocker.
TRADELOCKER_ENABLED=false
TRADELOCKER_ENVIRONMENT=demo
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_DEVELOPER_API_KEY=

# MetaTrader 5 only. Optional official package + local terminal required. Blank login/password/server uses terminal login. Login/server can pin identity; terminal path optional for selecting installation. demo/live must match account.
MT5_ENABLED=false
MT5_ENVIRONMENT=demo
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Tradovate scaffold (unsupported import). Keep disabled. Values only from provider-issued credentials.
TRADOVATE_ENABLED=false
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ENVIRONMENT=demo

# Autochartist scaffold (unsupported). Keep disabled. No portal scraping.
AUTOCHARTIST_ENABLED=false
AUTOCHARTIST_BROKER_ID=
AUTOCHARTIST_USER=
AUTOCHARTIST_ACCOUNT_TYPE=LIVE
AUTOCHARTIST_SECRET_KEY=

# SEC filings. Required only for SEC access: identify your application and contact email per SEC policy.
SEC_USER_AGENT=
SEC_DATA_BASE_URL=https://data.sec.gov
SEC_FILES_BASE_URL=https://www.sec.gov

# FRED macro data. API key required only for FRED, from your FRED developer account.
FRED_API_KEY=
FUNDAMENTALS_CACHE_HOURS=12
MACRO_CACHE_MINUTES=15
FRED_BASE_URL=https://api.stlouisfed.org

# Optional process-level in-memory chart cache limits (not loaded from dotenv).
LEDGER_FRAME_CACHE_ENTRIES=32
LEDGER_FRAME_CACHE_MB=256
LEDGER_FRAME_CACHE_TTL=120

# Frontend only: place in frontend/.env if API is not at the default local URL.
# Public URL only. Never put secrets in any VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000/api
